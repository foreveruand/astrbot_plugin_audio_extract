{
  "out_dir": {
    "type": "string",
    "default": "plugin_data/astrbot_plugin_audio_extract/output",
    "description": "（绝对路径）输出目录，用于存放提取的 MP3 文件和字幕文件"
  },
  "scan_dirs": {
    "type": "list",
    "default": [],
    "description": "文件扫描目录列表，用于建立文件索引",
    "items": {
      "type": "string"
    },
    "hint": "例如: [\"/path/to/videos\", \"/path/to/media\"]"
  },
  "index_extensions": {
    "type": "list",
    "default": [
      ".mp4",
      ".mkv",
      ".mov",
      ".wmv",
      ".flv",
      ".webm",
      ".ts",
      ".flac"
    ],
    "description": "建立文件索引时允许匹配的文件扩展名白名单",
    "items": {
      "type": "string"
    },
    "hint": "例如: [\".mp4\", \".mkv\", \"flac\"]；留空时不会索引任何文件"
  }
}
